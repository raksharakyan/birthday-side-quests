# Cloudflare Pages headers (GitHub Pages ignores this file — see docs/DECISIONS.md #2).
# The CSP line is regenerated at build time from csp.config.ts (adds the Worker origin if set).
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: https://tile.openstreetmap.org; font-src 'self'; connect-src 'self' https://nominatim.openstreetmap.org https://overpass-api.de; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: geolocation=(), camera=(), microphone=()
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
